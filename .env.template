# =============================================================================
# OrgGPT Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.template .env
# =============================================================================

# -----------------------------------------------------------------------------
# ChromaDB Configuration
# -----------------------------------------------------------------------------
# For local development (persistent mode):
CHROMA_CLIENT_TYPE=persistent
CHROMA_PATH=./chroma_db

# For Docker deployment (http mode):
# CHROMA_CLIENT_TYPE=http
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# OpenAI/Groq API Key (required for LLM functionality)
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# LLM Model (REQUIRED - no default value)
# Choose from available models:
#   - Groq: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
#   - OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Datadog Integration (Optional)
# -----------------------------------------------------------------------------
# Datadog API credentials (required for live Datadog data ingestion)
# Get these from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_application_key_here

# Datadog Site (default: datadoghq.com)
# Other options: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, etc.
DD_SITE=datadoghq.com

# Datadog POC Mode (for testing without API keys)
DATADOG_POC_ENABLED=true
DATADOG_CACHE_TTL=3600
DATADOG_AUTO_INGEST=false

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Server host and port
HOST=0.0.0.0
PORT=8001

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# -----------------------------------------------------------------------------
# Embedding Model Configuration (Optional)
# -----------------------------------------------------------------------------
# Embedding model for vector store (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Chunking Configuration (Optional)
# -----------------------------------------------------------------------------
# Text chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Logging Configuration (Optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
